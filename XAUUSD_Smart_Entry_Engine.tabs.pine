bool   iShowDash    = input.bool(true,  "Show dashboard", group = gGEN)
bool   iShowStory   = input.bool(true,  "Show Market Story panel", group = gGEN)
bool   iShowInfo    = input.bool(true,  "Show detailed info panel", group = gGEN)
int    iMaxSetups   = input.int(1,  "Maximum active setups", minval = 1, maxval = 3, group = gGEN)
int    iMaxHist     = input.int(3,  "Historical setups kept on chart", minval = 0, maxval = 12, group = gGEN)
int    iVisBars     = input.int(350, "Keep visuals for (bars)", minval = 50, maxval = 2000, group = gGEN)

